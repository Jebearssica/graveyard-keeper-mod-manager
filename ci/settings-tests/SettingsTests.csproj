<Project Sdk="Microsoft.NET.Sdk">

    <!--
        Offline checks for the settings editor. It compiles src/SettingField.cs directly - the part
        of the editor that turns arrows, typed text and cycles into values - and needs neither Unity
        nor BepInEx, so it runs anywhere:

            dotnet run (project ci/settings-tests) -c Release
    -->
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net8.0</TargetFramework>
        <LangVersion>preview</LangVersion>
        <Nullable>disable</Nullable>
        <ImplicitUsings>disable</ImplicitUsings>
        <AssemblyName>gkmm-settings-tests</AssemblyName>
        <RootNamespace>GkmmSettingsTests</RootNamespace>
        <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="Program.cs" />
        <Compile Include="Stubs.cs" />
        <Compile Include="..\..\src\SettingField.cs" Link="SettingField.cs" />
    </ItemGroup>

</Project>
