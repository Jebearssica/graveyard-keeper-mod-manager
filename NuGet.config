<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <!--
        BepInEx.PluginInfoProps (which generates MyPluginInfo from the project version) is
        published on the BepInEx feed, not nuget.org, so a clean clone needs both sources.
        <clear /> keeps whatever feeds happen to be configured on a machine out of the build.
    -->
    <packageSources>
        <clear />
        <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
        <add key="bepinex" value="https://nuget.bepinex.dev/v3/index.json" />
    </packageSources>
</configuration>
