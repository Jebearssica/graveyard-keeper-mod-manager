<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net481</TargetFramework>
        <LangVersion>preview</LangVersion>
        <AssemblyName>GKModManager</AssemblyName>
        <RootNamespace>GKModManager</RootNamespace>
        <Version>1.1.0</Version>
        <Copyright>GPL-3.0</Copyright>
        <Authors>Jebearssica</Authors>
        <Product>Mod Manager (GYK)</Product>
        <Description>In-game mod list and enable/disable manager for Graveyard Keeper (BepInEx 5)</Description>
        <Nullable>disable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
        <NoWarn>CS1591;Publicizer001</NoWarn>
        <DebugType>portable</DebugType>
        <Deterministic>true</Deterministic>
        <!-- Reference assemblies are supplied by the game; never copy them next to the plugin. -->
        <GenerateDependencyFile>false</GenerateDependencyFile>
    </PropertyGroup>

    <!--
        Point GameDir at your Graveyard Keeper install, either here or on the command line:
            dotnet build src/GKModManager.csproj -c Release -p:GameDir="D:\Games\Graveyard Keeper"
        The default matches a standard Steam library layout.
    -->
    <PropertyGroup>
        <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Graveyard Keeper</GameDir>
        <ManagedDir>$(GameDir)\Graveyard Keeper_Data\Managed</ManagedDir>
        <BepInExCore>$(GameDir)\BepInEx\core</BepInExCore>
        <!-- Deploy straight into the game when it exists; otherwise just build into bin\. -->
        <PluginDir Condition="Exists('$(GameDir)\BepInEx\plugins')">$(GameDir)\BepInEx\plugins\GKModManager</PluginDir>
        <OutputPath Condition="'$(PluginDir)' != ''">$(PluginDir)</OutputPath>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="BepInEx.PluginInfoProps" Version="2.1.0" PrivateAssets="all" />
    </ItemGroup>

    <!--
        A few members used for localisation are private in the shipped assemblies
        (GameSettings._cur_lng), so the game assemblies are publicized at build time only.
        Nothing is written back to the game directory.
    -->
    <ItemGroup>
        <PackageReference Include="BepInEx.AssemblyPublicizer.MSBuild" Version="0.4.3"
                          PrivateAssets="all" ExcludeAssets="compile;runtime" />
        <Publicize Include="Assembly-CSharp" PublicizeTarget="All"
                   PublicizeCompilerGenerated="false" IncludeOriginalAttributesAttribute="false" Strip="false" />
        <Publicize Include="Assembly-CSharp-firstpass" PublicizeTarget="All"
                   PublicizeCompilerGenerated="false" IncludeOriginalAttributesAttribute="false" Strip="false" />
    </ItemGroup>

    <ItemGroup>
        <Reference Include="BepInEx">
            <HintPath>$(BepInExCore)\BepInEx.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="0Harmony">
            <HintPath>$(BepInExCore)\0Harmony.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="Mono.Cecil">
            <HintPath>$(BepInExCore)\Mono.Cecil.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="Assembly-CSharp">
            <HintPath>$(ManagedDir)\Assembly-CSharp.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="Assembly-CSharp-firstpass">
            <HintPath>$(ManagedDir)\Assembly-CSharp-firstpass.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="UnityEngine">
            <HintPath>$(ManagedDir)\UnityEngine.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="UnityEngine.CoreModule">
            <HintPath>$(ManagedDir)\UnityEngine.CoreModule.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="UnityEngine.IMGUIModule">
            <HintPath>$(ManagedDir)\UnityEngine.IMGUIModule.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="UnityEngine.InputLegacyModule">
            <HintPath>$(ManagedDir)\UnityEngine.InputLegacyModule.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="UnityEngine.TextRenderingModule">
            <HintPath>$(ManagedDir)\UnityEngine.TextRenderingModule.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="UnityEngine.Physics2DModule">
            <HintPath>$(ManagedDir)\UnityEngine.Physics2DModule.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="UnityEngine.AnimationModule">
            <HintPath>$(ManagedDir)\UnityEngine.AnimationModule.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="UnityEngine.AudioModule">
            <HintPath>$(ManagedDir)\UnityEngine.AudioModule.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="UnityEngine.UIModule">
            <HintPath>$(ManagedDir)\UnityEngine.UIModule.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="UnityEngine.UI">
            <HintPath>$(ManagedDir)\UnityEngine.UI.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="UnityEngine.JSONSerializeModule">
            <HintPath>$(ManagedDir)\UnityEngine.JSONSerializeModule.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="UnityEngine.ImageConversionModule">
            <HintPath>$(ManagedDir)\UnityEngine.ImageConversionModule.dll</HintPath>
            <Private>false</Private>
        </Reference>
    </ItemGroup>

    <!-- Language files must sit next to the DLL. -->
    <ItemGroup>
        <Content Include="lang\*.json" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

</Project>
