<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net481</TargetFramework>
        <LangVersion>preview</LangVersion>
        <AssemblyName>GKModManager</AssemblyName>
        <RootNamespace>GKModManager</RootNamespace>
        <Version>1.1.0</Version>
        <Copyright>GPL-3.0</Copyright>
        <Authors>Jebearssica</Authors>
        <Product>Mod Manager (GYK)</Product>
        <Description>In-game mod list and enable/disable manager for Graveyard Keeper (BepInEx 5)</Description>
        <Nullable>disable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
        <NoWarn>CS1591;Publicizer001</NoWarn>
        <DebugType>portable</DebugType>
        <Deterministic>true</Deterministic>
        <!-- Keep the published DLL free of the git commit hash the SDK would append. -->
        <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
        <!-- Reference assemblies are supplied by the game; never copy them next to the plugin. -->
        <GenerateDependencyFile>false</GenerateDependencyFile>
    </PropertyGroup>

    <!--
        Two ways to build.

        Against a real install (the default, no arguments needed):
            dotnet build src/GKModManager.csproj -c Release
        Override the location with -p:GameDir="D:\Games\Graveyard Keeper". When the game has
        BepInEx installed the plugin is copied straight into it.

        Without a game install, using the declaration-only stubs in ci/refs (what CI does):
            dotnet build src/GKModManager.csproj -c Release -p:UseGameRefs=false -p:BepInExCore=<dir>
        BepInEx itself has to come from an extracted BepInEx release.
    -->
    <PropertyGroup>
        <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Graveyard Keeper</GameDir>
        <ManagedDir Condition="'$(ManagedDir)' == ''">$(GameDir)\Graveyard Keeper_Data\Managed</ManagedDir>
        <BepInExCore Condition="'$(BepInExCore)' == ''">$(GameDir)\BepInEx\core</BepInExCore>

        <UseGameRefs Condition="'$(UseGameRefs)' == '' AND Exists('$(ManagedDir)\Assembly-CSharp.dll')">true</UseGameRefs>
        <UseGameRefs Condition="'$(UseGameRefs)' == ''">false</UseGameRefs>

        <DeployToGame Condition="'$(DeployToGame)' == '' AND Exists('$(GameDir)\BepInEx\plugins')">true</DeployToGame>
        <DeployToGame Condition="'$(DeployToGame)' == ''">false</DeployToGame>

        <PluginDir Condition="'$(DeployToGame)' == 'true'">$(GameDir)\BepInEx\plugins\GKModManager</PluginDir>
        <OutputPath Condition="'$(PluginDir)' != ''">$(PluginDir)</OutputPath>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="BepInEx.PluginInfoProps" Version="2.1.0" PrivateAssets="all" />
        <!-- Keeps net481 buildable on machines without the .NET Framework targeting pack. -->
        <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    </ItemGroup>

    <!--
        A few members used for localisation are private in the shipped assemblies
        (GameSettings._cur_lng), so the game assemblies are publicized at build time only.
        Nothing is written back to the game directory.
    -->
    <ItemGroup Condition="'$(UseGameRefs)' == 'true'">
        <PackageReference Include="BepInEx.AssemblyPublicizer.MSBuild" Version="0.4.3"
                          PrivateAssets="all" ExcludeAssets="compile;runtime" />
        <Publicize Include="Assembly-CSharp" PublicizeTarget="All"
                   PublicizeCompilerGenerated="false" IncludeOriginalAttributesAttribute="false" Strip="false" />
        <Publicize Include="Assembly-CSharp-firstpass" PublicizeTarget="All"
                   PublicizeCompilerGenerated="false" IncludeOriginalAttributesAttribute="false" Strip="false" />
    </ItemGroup>

    <ItemGroup>
        <Reference Include="BepInEx">
            <HintPath>$(BepInExCore)\BepInEx.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="0Harmony">
            <HintPath>$(BepInExCore)\0Harmony.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="Mono.Cecil">
            <HintPath>$(BepInExCore)\Mono.Cecil.dll</HintPath>
            <Private>false</Private>
        </Reference>
    </ItemGroup>

    <!-- Against the real game: only the assemblies that are actually compiled against. -->
    <ItemGroup Condition="'$(UseGameRefs)' == 'true'">
        <Reference Include="Assembly-CSharp">
            <HintPath>$(ManagedDir)\Assembly-CSharp.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="Assembly-CSharp-firstpass">
            <HintPath>$(ManagedDir)\Assembly-CSharp-firstpass.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="UnityEngine">
            <HintPath>$(ManagedDir)\UnityEngine.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="UnityEngine.CoreModule">
            <HintPath>$(ManagedDir)\UnityEngine.CoreModule.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="UnityEngine.IMGUIModule">
            <HintPath>$(ManagedDir)\UnityEngine.IMGUIModule.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="UnityEngine.InputLegacyModule">
            <HintPath>$(ManagedDir)\UnityEngine.InputLegacyModule.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="UnityEngine.TextRenderingModule">
            <HintPath>$(ManagedDir)\UnityEngine.TextRenderingModule.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="UnityEngine.Physics2DModule">
            <HintPath>$(ManagedDir)\UnityEngine.Physics2DModule.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="UnityEngine.AnimationModule">
            <HintPath>$(ManagedDir)\UnityEngine.AnimationModule.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="UnityEngine.AudioModule">
            <HintPath>$(ManagedDir)\UnityEngine.AudioModule.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="UnityEngine.UIModule">
            <HintPath>$(ManagedDir)\UnityEngine.UIModule.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="UnityEngine.UI">
            <HintPath>$(ManagedDir)\UnityEngine.UI.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="UnityEngine.JSONSerializeModule">
            <HintPath>$(ManagedDir)\UnityEngine.JSONSerializeModule.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="UnityEngine.ImageConversionModule">
            <HintPath>$(ManagedDir)\UnityEngine.ImageConversionModule.dll</HintPath>
            <Private>false</Private>
        </Reference>
    </ItemGroup>

    <!-- Without the game: stubs for the game assemblies, Unity modules from NuGet. -->
    <ItemGroup Condition="'$(UseGameRefs)' != 'true'">
        <PackageReference Include="UnityEngine.Modules" Version="2021.3.33" IncludeAssets="compile" PrivateAssets="all" />
        <ProjectReference Include="..\ci\refs\Assembly-CSharp-firstpass\Assembly-CSharp-firstpass.csproj" Private="false" />
        <ProjectReference Include="..\ci\refs\Assembly-CSharp\Assembly-CSharp.csproj" Private="false" />
        <Compile Include="..\ci\IgnoresAccessChecksTo.cs" Link="Shared\IgnoresAccessChecksTo.cs" />
    </ItemGroup>

    <!-- Language files must sit next to the DLL. -->
    <ItemGroup>
        <Content Include="lang\*.json" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

</Project>
